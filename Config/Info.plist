<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Nur die Schlüssel, die Xcode nicht selber generiert.
		Alles Übrige (CFBundleName, Version, Szenen-Manifest …) kommt aus
		GENERATE_INFOPLIST_FILE = YES.
	-->

	<!-- Pflicht, damit die App eingehende iCloud-Freigabe-Einladungen annehmen darf.
	     Ohne diesen Schlüssel ruft iOS `userDidAcceptCloudKitShareWith` nie auf. -->
	<key>CKSharingSupported</key>
	<true/>

	<!-- CloudKit meldet Änderungen des Partnergeräts über stille Push-Nachrichten;
	     dafür braucht die App den Hintergrundmodus "remote-notification". -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>

	<!-- Dark Mode ist das primäre Erscheinungsbild der App. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>

	<!--
		Export-Compliance: Die App verwendet ausschliesslich die Verschlüsselung,
		die Apple selbst mitbringt (HTTPS für den EZB-Kursabruf, CloudKit-Transport).
		Damit gilt sie als ausgenommen; ohne diesen Schlüssel fragt App Store
		Connect bei jedem Build danach.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!--
		Bewusst NICHT gesetzt: NSAppTransportSecurity.
		Alle Netzzugriffe laufen über HTTPS (www.ecb.europa.eu), es braucht also
		keine ATS-Ausnahme. Ausnahmen wären im App-Review begründungspflichtig.

		Ebenfalls bewusst nicht gesetzt: Berechtigungen für Kamera, Kontakte,
		Standort, Fotos oder Mikrofon. Die App braucht keine davon.
	-->
</dict>
</plist>
