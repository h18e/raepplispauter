<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Die App-Group ist die einzige Verbindung zwischen App und Widget:
		Beide öffnen darüber dieselben UserDefaults (siehe
		Shared/WidgetSharing.swift). Die Kennung muss hier, in
		Config/Raepplispauter.entitlements und in WidgetSharing.appGroupID
		identisch sein.

		Achtung: App-Groups setzen das kostenpflichtige Apple Developer
		Program voraus – wie iCloud. Mit einer gratis Apple-ID lässt sich
		dieses Target nicht signieren.
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.ch.hebera.raepplispauter</string>
	</array>
</dict>
</plist>
