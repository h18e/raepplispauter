# Xcode
build/
DerivedData/
*.xcuserstate
xcuserdata/

# Wird von Xcode beim Öffnen des Projekts automatisch erzeugt und gehört
# niemandem ausser dem lokalen Rechner.
*.xcodeproj/project.xcworkspace/
*.xcworkspace/xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# macOS
.DS_Store

# Swift Package Manager
.swiftpm/
.build/

# String-Katalog: Alle Texte stehen als defaultValue in Resources/Strings.swift.
# Xcode legt den Katalog beim Bauen unter Umständen neu an – er darf aber nicht
# wieder in git landen, sonst kollidiert er bei jedem Pull mit dem Stand aus
# Strings.swift. Erst wenn eine zweite Sprache dazukommt, wird er gebraucht.
Raepplispauter/Resources/Localizable.xcstrings

# Persönliche Signierungs-Einstellungen. Die Team-Kennung gehört zum
# Entwickler-Account, nicht zum Projekt – siehe Config/Signing.xcconfig.
# Vorlage: Config/Local.xcconfig.example
Config/Local.xcconfig
